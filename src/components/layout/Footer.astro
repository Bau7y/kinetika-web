---
import Logo from '../brand/Logo.astro';
import { site } from '../../data/site';
import { getProjects, getServices } from '../../data/work';
import { getLegalPages } from '../../data/legal';
import { homeAnchor, routes, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Show the "replay the intro" button (pages with the intro). */
  replayIntro?: boolean;
}
const { lang, replayIntro = false } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const services = await getServices(lang);
const projects = await getProjects(lang);
const legalPages = await getLegalPages(lang);

const company = [
  { href: routes.about[lang], label: t('nav.about') },
  { href: routes.howWeWork[lang], label: t('nav.how_we_work') },
  { href: homeAnchor(lang, 'preguntas'), label: t('nav.faq') },
  { href: routes.guides[lang], label: t('nav.guides') },
  { href: routes.quote[lang], label: t('nav.contact') },
];
---
<footer class="footer">
  <div class="container">
    <div class="footer_grid">
      <div class="footer_brand">
        <a href={routes.home[lang]} class="footer_logo" aria-label={t('nav.home_label')} translate="no">
          <Logo />
        </a>
        <p>{t('site.description')}</p>
        {site.email && <a href={`mailto:${site.email}`} class="footer_mail">{site.email}</a>}
      </div>

      <nav class="footer_col" aria-labelledby="footer_services">
        <h2 id="footer_services"><a href={routes.solutions[lang]}>{t('nav.solutions')}</a></h2>
        <ul role="list">
          {services.map((s) => <li><a href={s.href}>{s.data.name}</a></li>)}
        </ul>
      </nav>

      <nav class="footer_col" aria-labelledby="footer_projects">
        <h2 id="footer_projects"><a href={routes.projectsBase[lang]}>{t('nav.experience')}</a></h2>
        <ul role="list">
          {projects.map((p) => <li><a href={p.href}>{p.data.name}</a></li>)}
        </ul>
      </nav>

      <nav class="footer_col" aria-labelledby="footer_company">
        <h2 id="footer_company">{t('footer.company')}</h2>
        <ul role="list">
          {company.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer_col" aria-labelledby="footer_legal">
        <h2 id="footer_legal">{t('footer.legal')}</h2>
        <ul role="list">
          {legalPages.map((p) => <li><a href={p.href}>{p.data.title}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="footer_bottom">
      <p translate="no">© {year} {site.name}. {t('footer.rights')}</p>
      <div class="footer_bottom_end">
        <p>{t('footer.location')}</p>
        {replayIntro && <button type="button" class="btn btn_ghost btn_sm" data-intro-replay>{t('footer.replay_intro')}</button>}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color_line);
    padding-block: var(--space_2xl) var(--space_lg);
    font-size: var(--text_sm);
    color: var(--color_text_muted);
  }

  .footer_mail {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap_min);
    margin-top: 6px;
    font-weight: 500;
    word-break: break-all;
  }

  .footer_grid {
    display: grid;
    gap: var(--space_lg);
    margin-bottom: var(--space_xl);
  }

  .footer_logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap_min);
    color: var(--color_text);
    text-decoration: none;
  }


  .footer_brand p {
    margin-top: var(--space_xs);
    max-width: 34ch;
  }

  .footer :global(.footer_col h2) {
    margin-bottom: var(--space_xs);
    font-family: var(--font_mono);
    font-size: var(--text_xs);
    font-weight: 500;
    letter-spacing: var(--tracking_label);
    text-transform: uppercase;
    color: var(--color_text_muted);
  }

  .footer :global(.footer_col h2 a) {
    min-height: 0;
    color: inherit;
  }

  .footer :global(.footer_col ul) {
    display: grid;
    gap: 0.15rem;
  }

  .footer :global(.footer_col a) {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--color_nav_link);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer :global(.footer_col a:hover) {
      color: var(--color_accent_hover);
    }
  }

  .footer_bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space_sm);
    padding-top: var(--space_md);
    border-top: 1px solid var(--color_line);
  }

  .footer_bottom_end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space_sm) var(--space_md);
  }

  @media (min-width: 640px) {
    .footer_grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer_grid > :first-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .footer_grid {
      grid-template-columns: 1.5fr repeat(4, 1fr);
    }

    .footer_grid > :first-child {
      grid-column: auto;
    }
  }
</style>
