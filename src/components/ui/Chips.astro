---
/** Row of small outlined labels (capabilities, tags, skills, districts). */
interface Props {
  items: string[];
  /** Accessible name of the list. */
  label?: string;
  tone?: 'line' | 'accent';
  class?: string;
}
const { items, label, tone = 'line', class: className } = Astro.props;
---
<ul role="list" class:list={['chips', `chips_${tone}`, className]} aria-label={label}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    padding: 6px 12px;
    border-radius: var(--radius_full);
    font-size: var(--text_sm);
    color: var(--color_text_secondary);
  }

  .chips_line li {
    border: 1px solid var(--color_line_strong);
  }

  .chips_accent li {
    border: 1px solid var(--color_accent_border);
    background: var(--color_accent_tint);
    color: var(--color_text);
  }
</style>
