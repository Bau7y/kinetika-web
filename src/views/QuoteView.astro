---
/** Quote page: the same chat as the home page, as the page's main content. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import { breadcrumbSchema } from '../lib/structured_data';
import QuoteChat from '../components/sections/QuoteChat.astro';
import { getLegalHref } from '../data/legal';
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const privacyHref = await getLegalHref('privacidad', lang);
const crumbs = [
  { name: t('nav.home'), href: routes.home[lang] },
  { name: t('nav.quote'), href: routes.quote[lang] },
];
---
<BaseLayout lang={lang} title={t('quote.page_title')} description={t('quote.meta')} alternates={routes.quote}>
  <JsonLd slot="head" data={breadcrumbSchema(Astro.site!, crumbs)} />
  <div class="container quote_crumbs">
    <Breadcrumbs lang={lang} items={crumbs} />
  </div>
  <QuoteChat lang={lang} id="cotizacion" as="h1" privacyHref={privacyHref} />
</BaseLayout>

<style>
  .quote_crumbs {
    padding-top: calc(var(--navbar_h) + var(--space_sm));
  }

  .quote_crumbs + :global(section) {
    padding-top: var(--space_lg);
    border-top: 0;
    background: transparent;
  }
</style>
