---
/**
 * Opening scene. The h1 is the Largest Contentful Paint: it is never
 * animated. Secondary elements rise in after the intro (or right away when
 * the intro does not play).
 */
import { Picture } from 'astro:assets';
import heroImage from '../../assets/hero.jpg';
import Button from '../ui/Button.astro';
import { homeAnchor, routes, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// The lede appears word by word (secondary text only: the h1 paints at once)
const words = t('hero.lede').split(' ');
const anchor = (id: string) => homeAnchor(lang, id);
---
<section class="hero" aria-labelledby="hero_title" data-hero>
  <Picture
    src={heroImage}
    formats={['avif', 'webp']}
    widths={[960, 1600, 2400]}
    sizes="100vw"
    alt=""
    loading="eager"
    fetchpriority="high"
    class="hero_bg"
  />

  <div class="hero_body container">
    <h1 id="hero_title" class="hero_title">{t('hero.title_a')} <span>{t('hero.title_b')}</span></h1>
    <p class="hero_lede">
      {words.map((word, i) => <Fragment>{i > 0 && ' '}<span class="hero_word">{word}</span></Fragment>)}
    </p>
    <div class="hero_actions hero_in" data-i="2">
      <Button href={routes.quote[lang]} arrow>{t('nav.quote')}</Button>
      <Button href={anchor('proyectos')} variant="ghost">{t('hero.cta_secondary')}</Button>
    </div>
  </div>

  <!-- The Kinetika K, large and quiet: three glass planes crossed by a beam -->
  <svg class="hero_mark hero_in" data-i="3" aria-hidden="true" focusable="false" viewBox="0 0 100 100">
    <g class="hero_mark_planes">
      <polygon points="26,8 40,8 30,92 16,92" />
      <polygon points="40,50 72,8 90,8 52,58" />
      <polygon points="47,53 58,45 86,92 69,92" />
    </g>
    <line class="hero_mark_beam" x1="2" y1="80" x2="98" y2="22" />
  </svg>

</section>

<script>
  import { initHeroLines } from '../../scripts/hero_lines';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initHeroLines(hero);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding-top: var(--navbar_h);
    overflow: hidden;
    background: radial-gradient(90% 70% at 50% 35%, #172b5c, var(--color_bg) 70%);
  }

  .hero :global(.hero_bg) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    transition: opacity 900ms ease;
  }

  /* Live lines (canvas added by scripts/hero_lines.ts): cross-fade with the image */
  .hero :global(.hero_lines) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 900ms ease;
  }

  .hero:global(.lines_live) :global(.hero_lines) {
    opacity: 0.7;
  }

  .hero:global(.lines_live) :global(.hero_bg) {
    opacity: 0;
  }

  .hero_body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: var(--space_lg) var(--space_2xl);
    text-align: left;
  }

  /* What and where, in words search engines and assistants read first */
  .hero_title {
    max-width: 11em;
    font-size: var(--text_display);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .hero_title span {
    color: var(--color_accent_text);
  }

  .hero_lede {
    max-width: 36rem;
    margin-top: var(--space_md);
    font-size: var(--text_lg);
    color: var(--color_text_secondary);
  }

  .hero_actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 12px;
    margin-top: 36px;
  }

  /* The K: outline only, so it reads as light on glass, not as a logo sticker */
  .hero_mark {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -6vw;
    width: min(88vw, 640px);
    height: auto;
    translate: 0 -44%;
    opacity: 0.22;
    pointer-events: none;
  }

  .hero_mark_planes polygon {
    fill: rgb(150 190 255 / 0.07);
    stroke: rgb(200 220 255 / 0.55);
    stroke-width: 1.25px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .hero_mark_beam {
    stroke: var(--color_accent_text);
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 6px var(--color_accent));
  }

  @media (min-width: 900px) {
    .hero_mark {
      right: clamp(2rem, 6vw, 8rem);
      width: min(34vw, 500px);
      opacity: 0.85;
    }
  }

  /* Word by word: each word rises a little, 28 ms after the previous one */
  .hero_word {
    display: inline-block;
  }

  .hero_word:nth-child(1) { --w: 0; }
  .hero_word:nth-child(2) { --w: 1; }
  .hero_word:nth-child(3) { --w: 2; }
  .hero_word:nth-child(4) { --w: 3; }
  .hero_word:nth-child(5) { --w: 4; }
  .hero_word:nth-child(6) { --w: 5; }
  .hero_word:nth-child(7) { --w: 6; }
  .hero_word:nth-child(8) { --w: 7; }
  .hero_word:nth-child(9) { --w: 8; }
  .hero_word:nth-child(10) { --w: 9; }
  .hero_word:nth-child(11) { --w: 10; }
  .hero_word:nth-child(12) { --w: 11; }
  .hero_word:nth-child(13) { --w: 12; }
  .hero_word:nth-child(14) { --w: 13; }
  .hero_word:nth-child(15) { --w: 14; }
  .hero_word:nth-child(16) { --w: 15; }
  .hero_word:nth-child(17) { --w: 16; }
  .hero_word:nth-child(18) { --w: 17; }
  .hero_word:nth-child(19) { --w: 18; }
  .hero_word:nth-child(20) { --w: 19; }
  .hero_word:nth-child(21) { --w: 20; }
  .hero_word:nth-child(22) { --w: 21; }
  .hero_word:nth-child(23) { --w: 22; }
  .hero_word:nth-child(24) { --w: 23; }
  .hero_word:nth-child(25) { --w: 24; }
  .hero_word:nth-child(26) { --w: 25; }
  .hero_word:nth-child(27) { --w: 26; }
  .hero_word:nth-child(28) { --w: 27; }
  .hero_word:nth-child(29) { --w: 28; }
  .hero_word:nth-child(30) { --w: 29; }
  .hero_word:nth-child(31) { --w: 30; }
  .hero_word:nth-child(32) { --w: 31; }
  .hero_word:nth-child(33) { --w: 32; }
  .hero_word:nth-child(34) { --w: 33; }
  .hero_word:nth-child(35) { --w: 34; }
  .hero_word:nth-child(36) { --w: 35; }
  .hero_word:nth-child(37) { --w: 36; }
  .hero_word:nth-child(38) { --w: 37; }
  .hero_word:nth-child(39) { --w: 38; }
  .hero_word:nth-child(40) { --w: 39; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero_word {
      animation: hero_word 700ms var(--ease_out) calc(260ms + var(--w, 0) * 28ms) both;
    }

    /* The words rise while the intro backdrop dissolves (starts 1150 ms) */
    :global(html.intro) .hero_word {
      animation-delay: calc(1400ms + var(--w, 0) * 28ms);
    }
  }

  @keyframes hero_word {
    from {
      opacity: 0;
      transform: translateY(0.45em);
    }
  }

  /* Entrance of the secondary elements (never the h1): a longer, softer rise */
  @keyframes hero_rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero_in {
      animation: hero_rise 900ms var(--ease_out) calc(120ms + var(--i) * 110ms) both;
    }

    /* While the intro dissolves (it starts at 1150 ms and ends at 1800 ms) */
    :global(html.intro) .hero_in {
      animation-delay: calc(1500ms + var(--i) * 110ms);
    }
  }
  /*
   * Scroll story, part of the text: while the hero leaves the viewport its
   * content drifts up and fades, as the lines behind it fall into order.
   * Compositor-only (transform, opacity); browsers without scroll-driven
   * animations simply scroll it away.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero {
        view-timeline-name: --hero;
      }

      .hero_body {
        animation: hero_leave linear both;
      }

      /* Separate rule: the minifier folds a timeline set beside the
         shorthand into it, which browsers then drop */
      .hero .hero_body {
        animation-timeline: --hero;
        animation-range: exit 0% exit 70%;
      }
    }
  }

  @keyframes hero_leave {
    to {
      opacity: 0;
      transform: translateY(-12vh) scale(0.98);
    }
  }
</style>
