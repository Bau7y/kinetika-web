---
import type { GetStaticPaths } from 'astro';
import ProductView from '../../../views/ProductView.astro';
import { getProducts, type Product } from '../../../data/products';
import { demos } from '../../../components/product/demos';

export const getStaticPaths = (async () =>
  (await getProducts('en')).map((product) => ({ params: { slug: product.data.url_slug }, props: { product } }))) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const Demo = demos[product.key] as ((props: { lang: 'es' | 'en' }) => unknown) | undefined;
---
<ProductView lang="en" product={product}>
  {Demo && <Demo slot="demo" lang="en" />}
</ProductView>
