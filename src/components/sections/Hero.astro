---
/**
 * Opening scene. The h1 is the Largest Contentful Paint: it is never
 * animated. Secondary elements rise in after the intro (or right away when
 * the intro does not play).
 */
import { Picture } from 'astro:assets';
import heroImage from '../../assets/hero.jpg';
import Button from '../ui/Button.astro';
import { homeAnchor, routes, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const capabilities = t('services.capabilities').split('|');
const anchor = (id: string) => homeAnchor(lang, id);
---
<section class="hero" aria-labelledby="hero_title" data-hero>
  <Picture
    src={heroImage}
    formats={['avif', 'webp']}
    widths={[960, 1600, 2400]}
    sizes="100vw"
    alt=""
    loading="eager"
    fetchpriority="high"
    class="hero_bg"
  />

  <div class="hero_body container">
    <p class="hero_kicker"><span class="hero_dot" aria-hidden="true"></span>{t('hero.kicker')}</p>
    <h1 id="hero_title" class="hero_title">{t('hero.title_a')} <span>{t('hero.title_b')}</span></h1>
    <p class="hero_lede hero_in" data-i="0">{t('hero.lede')}</p>
    <div class="hero_actions hero_in" data-i="1">
      <Button href={routes.quote[lang]} arrow>{t('nav.quote')}</Button>
      <Button href={anchor('proyectos')} variant="ghost">{t('hero.cta_secondary')}</Button>
    </div>
    <a href={anchor('proyectos')} class="hero_scroll hero_in" data-i="2">
      <span>{t('hero.scroll_a')}</span>
      <span class="hero_mouse" aria-hidden="true"><span></span></span>
      <span>{t('hero.scroll_b')}</span>
    </a>
  </div>

  <!-- What we build, as a quiet marquee. The second copy only fills the loop. -->
  <div class="hero_strip hero_in" data-i="3">
    <div class="hero_marquee">
      <ul role="list" class="hero_marquee_track" aria-label={t('services.capabilities_label')}>
        {capabilities.map((c) => <li>{c}</li>)}
      </ul>
      <ul role="list" class="hero_marquee_track" aria-hidden="true">
        {capabilities.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  import { initHeroLines } from '../../scripts/hero_lines';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initHeroLines(hero);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding-top: var(--navbar_h);
    overflow: hidden;
    background: radial-gradient(90% 70% at 50% 35%, #172b5c, var(--color_bg) 70%);
  }

  .hero :global(.hero_bg) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    transition: opacity 900ms ease;
  }

  /* Live lines (canvas added by scripts/hero_lines.ts): cross-fade with the image */
  .hero :global(.hero_lines) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 900ms ease;
  }

  .hero:global(.lines_live) :global(.hero_lines) {
    opacity: 0.7;
  }

  .hero:global(.lines_live) :global(.hero_bg) {
    opacity: 0;
  }

  .hero_body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: var(--space_lg) var(--space_2xl);
    text-align: center;
  }

  /* What and where, in words search engines and assistants read first */
  .hero_kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--space_md);
    padding: 8px 16px;
    border-radius: var(--radius_full);
    border: 1px solid var(--color_accent_border);
    background: rgb(13 20 34 / 0.6);
    font-size: var(--text_sm);
    color: var(--color_text);
  }

  .hero_dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color_accent);
    box-shadow: 0 0 10px var(--color_accent);
  }

  .hero_title {
    max-width: 1040px;
    font-size: var(--text_display);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .hero_title span {
    color: var(--color_accent_text);
  }

  .hero_lede {
    max-width: 36rem;
    margin-top: var(--space_md);
    font-size: var(--text_lg);
    color: var(--color_text_secondary);
  }

  .hero_actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .hero_scroll {
    display: none;
    align-items: center;
    gap: 16px;
    margin-top: var(--space_xl);
    font-size: var(--text_sm);
    color: var(--color_text_muted);
    text-decoration: none;
  }

  .hero_scroll::before,
  .hero_scroll::after {
    content: '';
    order: 1;
    width: clamp(40px, 12vw, 160px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color_line_strong));
  }

  .hero_scroll::after {
    order: 3;
    background: linear-gradient(90deg, var(--color_line_strong), transparent);
  }

  .hero_scroll > :first-child {
    order: 0;
  }

  .hero_mouse {
    order: 2;
    display: grid;
    justify-items: center;
    width: 18px;
    height: 28px;
    padding-top: 5px;
    border: 1.5px solid var(--color_text_secondary);
    border-radius: 10px;
  }

  .hero_mouse span {
    width: 2px;
    height: 6px;
    border-radius: 2px;
    background: var(--color_text);
  }

  .hero_scroll > :last-child {
    order: 4;
  }

  @media (min-width: 900px) and (hover: hover) {
    .hero_scroll {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero_mouse span {
      animation: hero_wheel 1.8s var(--ease_in_out) infinite;
    }
  }

  @keyframes hero_wheel {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    60% {
      transform: translateY(8px);
      opacity: 0;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero_scroll:hover {
      color: var(--color_text);
    }
  }

  .hero_strip {
    border-top: 1px solid var(--color_line);
    background: rgb(7 11 20 / 0.6);
  }

  /* Marquee: two identical tracks slide by their own width (transform only) */
  .hero_marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .hero_marquee_track {
    flex: none;
    display: flex;
    gap: 48px;
    padding: 22px 24px;
    font-size: var(--text_md);
    font-weight: 500;
    color: var(--color_text_muted);
    white-space: nowrap;
  }

  .hero_marquee_track li::before {
    content: '✦';
    margin-right: 48px;
    color: var(--color_line_strong);
  }

  .hero_marquee_track li:first-child::before {
    content: none;
  }

  .hero_marquee_track li:first-child {
    margin-left: 0;
  }

  .hero_marquee_track + .hero_marquee_track li:first-child::before {
    content: '✦';
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero_marquee_track {
      animation: hero_marquee 40s linear infinite;
    }

    @media (hover: hover) and (pointer: fine) {
      .hero_marquee:hover .hero_marquee_track {
        animation-play-state: paused;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero_marquee {
      justify-content: center;
    }

    .hero_marquee_track {
      flex-wrap: wrap;
      justify-content: center;
      white-space: normal;
    }

    .hero_marquee_track[aria-hidden='true'] {
      display: none;
    }
  }

  @keyframes hero_marquee {
    to {
      transform: translateX(-100%);
    }
  }

  /* Entrance of the secondary elements (never the h1) */
  @keyframes hero_rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero_in {
      animation: hero_rise 520ms var(--ease_out) calc(80ms + var(--i) * 80ms) both;
    }

    /* After the intro curtain lifts (1550 ms + 640 ms) */
    :global(html.intro) .hero_in {
      animation-delay: calc(1820ms + var(--i) * 80ms);
    }
  }
</style>
