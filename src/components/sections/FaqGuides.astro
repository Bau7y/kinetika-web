---
/** Frequent questions (FAQPage) and a preview of the guides (Article). */
import { faq } from '../../data/faq';
import FaqPanel from '../ui/FaqPanel.astro';
import GuideCards from '../ui/GuideCards.astro';
import { getGuides } from '../../data/guides';
import { routes, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Position in the home page, set by HomeView. */
  number: string;
}
const { lang, number } = Astro.props;
const t = useTranslations(lang);
const items = faq[lang];
const guides = (await getGuides(lang)).slice(0, 3);

---
<section id="preguntas" class="section container" aria-labelledby="faq_title">
  <p class="section_label" data-reveal data-i="0"><span>{number}</span>{t('label.faq')}</p>
  <h2 id="faq_title" class="section_title faq_title" data-reveal data-i="1">{t('faq.title')}</h2>
  <FaqPanel items={items} />

  <div class="guides_head">
    <h3>{t('guides.preview_title')}</h3>
    <a href={routes.guides[lang]}>{t('guides.see_all')}</a>
  </div>
  <GuideCards guides={guides} />
</section>

<style>
  .faq_title {
    max-width: 800px;
    margin-bottom: var(--space_md);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .guides_head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space_sm);
    margin-top: var(--space_xl);
  }

  .guides_head h3 {
    font-size: var(--text_h3);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .guides_head + :global(.guide_cards) {
    margin-top: var(--space_md);
  }

  .guides_head a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap_min);
    font-size: 0.9375rem;
    font-weight: 500;
  }

</style>
