---
/** Privacy policy and legal notice, in both languages. */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Prose from '../components/ui/Prose.astro';
import { getLegalPages, type LegalPage } from '../data/legal';
import { pairHrefs } from '../data/pages';
import { formatDate, routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: LegalPage;
}
const { lang, page } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(page);
const alternates = pairHrefs({ es: await getLegalPages('es'), en: await getLegalPages('en') })(page.key, lang);
const crumbs = [
  { name: t('nav.home'), href: routes.home[lang] },
  { name: page.data.title, href: page.href },
];
---
<BaseLayout lang={lang} title={page.data.title} description={page.data.meta_description} alternates={alternates}>
  <slot name="head" slot="head" />
  <article class="legal container" aria-labelledby="legal_title">
    <Breadcrumbs lang={lang} items={crumbs} />
    <h1 id="legal_title">{page.data.title}</h1>
    <p class="legal_updated">{t('updated.label')} <time datetime={page.data.updated.toISOString().slice(0, 10)}>{formatDate(page.data.updated, lang)}</time></p>
    <Prose><Content /></Prose>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-top: calc(var(--navbar_h) + var(--space_sm));
    padding-bottom: var(--section_py);
  }

  .legal h1 {
    margin-top: var(--space_lg);
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    font-weight: 700;
    line-height: var(--leading_tight);
    letter-spacing: -0.03em;
  }

  .legal_updated {
    margin: var(--space_sm) 0 var(--space_xl);
    font-size: var(--text_sm);
    color: var(--color_text_muted);
  }
</style>
