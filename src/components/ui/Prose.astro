---
/** Typography for long Markdown content (product notes, guides, legal pages). */
---
<div class="prose"><slot /></div>

<style>
  .prose {
    max-width: 68ch;
    color: var(--color_text_secondary);
  }

  .prose :global(h2) {
    margin: 2.75rem 0 1rem;
    font-size: clamp(1.375rem, 2.3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color_text);
  }

  .prose :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: var(--text_xl);
    font-weight: 600;
    color: var(--color_text);
  }

  .prose :global(h2:first-child),
  .prose :global(h3:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }

  .prose :global(li::marker) {
    color: var(--color_accent);
  }

  .prose :global(strong) {
    color: var(--color_text);
    font-weight: 600;
  }

  .prose :global(a) {
    text-decoration: underline;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text_sm);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--color_line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    color: var(--color_text);
    font-weight: 600;
  }
</style>
