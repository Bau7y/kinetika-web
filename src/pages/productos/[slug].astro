---
import type { GetStaticPaths } from 'astro';
import ProductView from '../../views/ProductView.astro';
import { getProducts, type Product } from '../../data/products';
import { demos } from '../../components/product/demos';

export const getStaticPaths = (async () =>
  (await getProducts('es')).map((product) => ({ params: { slug: product.data.url_slug }, props: { product } }))) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const Demo = demos[product.key];
---
<ProductView lang="es" product={product}>
  {Demo && <Demo slot="demo" lang="es" />}
</ProductView>
