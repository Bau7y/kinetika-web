# Copiá este archivo como .env y completá los valores. .env no se sube a git;
# en producción las mismas variables se cargan en Vercel.

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Bandeja que recibe las cotizaciones y la lista de espera
CONTACT_TO=

# Remitente con un dominio verificado en Resend, por ejemplo:
# CONTACT_FROM=Kinetika <hola@kinetikacr.com>
CONTACT_FROM=

# Opcionales: cada capa anti-spam se activa solo si existen sus claves
# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis (límite de envíos compartido): https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
