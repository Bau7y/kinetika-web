---
/**
 * Quote request as a three-step chat. The markup is a real form (one
 * fieldset per question, radios styled as chips); the script turns it into
 * a conversation. Without JS every question is visible at once.
 */
import { BUSINESS_TYPES, MESSAGE_MAX, NEEDS } from '../../data/quote_options';
import { useTranslations, type Lang, type UiKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Section id (anchor); the home page uses "contacto". */
  id?: string;
  /** Heading level: h2 inside the home page, h1 on the quote page. */
  as?: 'h1' | 'h2';
  privacyHref: string;
}
const { lang, id = 'contacto', as: Heading = 'h2', privacyHref } = Astro.props;
const t = useTranslations(lang);

const errorKeys = [
  'business_required', 'need_required', 'email_required', 'email_invalid', 'email_unreachable', 'message_max',
  'consent_required', 'rate_limited', 'captcha_failed', 'offensive', 'generic',
] as const;
const errors = Object.fromEntries(errorKeys.map((k) => [k, t(`error.${k}` as UiKey)]));
---
<section id={id} class="section section_band quote" aria-labelledby={`${id}_title`}>
  <div class="container quote_grid">
    <div class="quote_intro">
      <Heading id={`${id}_title`} class="section_title">{t('quote.title')}</Heading>
      <p class="lede">{t('quote.lede')}</p>
      <div class="quote_progress" data-quote-progress aria-hidden="true">
        <span class="quote_bar is_on"></span><span class="quote_bar"></span><span class="quote_bar"></span>
        <span class="mono quote_progress_label" data-template={t('quote.progress')}>{t('quote.progress').replace('{n}', '1')}</span>
      </div>
    </div>

    <form class="chat" novalidate aria-label={t('quote.form_label')} data-quote data-errors={JSON.stringify(errors)} data-lang={lang}>
      <input type="hidden" name="lang" value={lang} />

      <fieldset class="chat_step" data-step="0">
        <legend class="chat_bubble chat_them">{t('quote.q_business')}</legend>
        <p class="chat_bubble chat_us" data-answer hidden></p>
        <div class="chat_options">
          {BUSINESS_TYPES.map((key) => (
            <label class="chat_option">
              <input type="radio" name="business" value={key} required />
              <span>{t(`quote.business.${key}` as UiKey)}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="chat_step" data-step="1">
        <legend class="chat_bubble chat_them">{t('quote.q_need')}</legend>
        <p class="chat_bubble chat_us" data-answer hidden></p>
        <div class="chat_options">
          {NEEDS.map((key) => (
            <label class="chat_option">
              <input type="radio" name="need" value={key} required />
              <span>{t(`quote.need.${key}` as UiKey)}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="chat_step" data-step="2">
        <legend class="chat_bubble chat_them">{t('quote.q_contact')}</legend>

        <div class="chat_errors" role="alert" tabindex="-1" data-error-summary hidden>
          <p>{t('quote.errors_title')}</p>
          <ul></ul>
        </div>

        <div class="chat_field">
          <label for={`${id}_email`}>{t('quote.email')}</label>
          <input
            id={`${id}_email`}
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            spellcheck="false"
            placeholder={t('quote.email_placeholder')}
            aria-describedby={`${id}_email_error`}
            maxlength="254"
            required
          />
          <p id={`${id}_email_error`} class="chat_error" data-error-for="email"></p>
        </div>

        <div class="chat_field">
          <label for={`${id}_message`}>{t('quote.message')}</label>
          <textarea id={`${id}_message`} name="message" rows="3" maxlength={MESSAGE_MAX} aria-describedby={`${id}_message_error`}></textarea>
          <p id={`${id}_message_error`} class="chat_error" data-error-for="message"></p>
        </div>

        <div class="chat_field">
          <label class="chat_consent">
            <input id={`${id}_consent`} name="consent" type="checkbox" aria-describedby={`${id}_consent_error`} required />
            <span>{t('quote.consent_before')} <a href={privacyHref}>{t('quote.consent_link')}</a> {t('quote.consent_after')}</span>
          </label>
          <p id={`${id}_consent_error`} class="chat_error" data-error-for="consent"></p>
        </div>

        <slot name="protection" />

        <button type="submit" class="btn btn_primary chat_submit" data-label={t('quote.submit')} data-sending={t('quote.sending')}>{t('quote.submit')}</button>
        <noscript><p class="chat_error">{t('quote.noscript')}</p></noscript>
      </fieldset>

      <p class="chat_bubble chat_them chat_done" data-done tabindex="-1" hidden>{t('quote.done')}</p>
      <p class="visually_hidden" aria-live="polite" data-live></p>

      <button type="button" class="chat_restart" data-restart hidden>{t('quote.restart')}</button>
    </form>
  </div>
</section>

<script>
  import { initQuoteChat } from '../../scripts/quote_chat';
  document.querySelectorAll<HTMLFormElement>('[data-quote]').forEach((form) => initQuoteChat(form));
</script>

<style>
  .quote_grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space_xl);
  }

  .quote_intro {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .quote_intro .lede {
    max-width: 440px;
  }

  .quote_progress {
    display: none;
    align-items: center;
    gap: 8px;
  }

  :global(html.js) .quote_progress {
    display: flex;
  }

  .quote_bar {
    width: 64px;
    height: 4px;
    border-radius: 2px;
    background: var(--color_line_strong);
    overflow: hidden;
    position: relative;
  }

  .quote_bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color_accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--duration_base) var(--ease_out);
  }

  .quote_bar.is_on::after {
    transform: scaleX(1);
  }

  .quote_progress_label {
    margin-left: 8px;
    font-size: var(--text_xs);
    color: var(--color_text_muted);
  }

  .chat {
    flex: 1.3 1 460px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border-radius: var(--radius_2xl);
    background: var(--color_bg);
    border: 1px solid var(--color_line);
  }

  .chat_step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 0;
    border: 0;
  }

  .chat_bubble {
    max-width: 80%;
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* legend ignores flex: float + width keep it as a bubble */
  legend.chat_bubble {
    float: left;
    width: fit-content;
  }

  legend.chat_bubble + * {
    clear: both;
  }

  .chat_them {
    align-self: flex-start;
    background: var(--color_raised);
  }

  .chat_us {
    align-self: flex-end;
    background: var(--color_cta);
    color: var(--color_on_cta);
  }

  .chat_options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .chat_option {
    position: relative;
  }

  .chat_option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .chat_option span {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap_min);
    padding-inline: 16px;
    border-radius: 12px;
    border: 1px solid var(--color_accent_border_strong);
    background-color: var(--color_accent_tint);
    color: var(--color_accent_text);
    font-size: var(--text_sm);
    font-weight: 500;
    transition: background-color var(--duration_fast) ease, transform var(--duration_press) var(--ease_out);
  }

  .chat_option input:checked + span {
    background-color: var(--color_cta);
    border-color: var(--color_cta);
    color: var(--color_on_cta);
  }

  .chat_option input:focus-visible + span {
    outline: 2px solid var(--color_accent_text);
    outline-offset: 3px;
  }

  .chat_option:active span {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .chat_option:hover span {
      background-color: var(--color_accent_tint_strong);
    }
  }

  .chat_field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chat_field > label:not(.chat_consent) {
    font-size: var(--text_sm);
    font-weight: 500;
  }

  .chat_field input[type='email'],
  .chat_field textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    border-radius: var(--radius_md);
    border: 1px solid var(--color_line_strong);
    background-color: var(--color_surface);
    font-size: var(--text_base);
  }

  .chat_field textarea {
    resize: vertical;
  }

  .chat_field [aria-invalid='true'] {
    border-color: var(--color_bad);
  }

  .chat_consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    min-height: var(--tap_min);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color_text_secondary);
    cursor: pointer;
  }

  .chat_consent input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--color_cta);
  }

  .chat_error {
    font-size: 0.8125rem;
    color: var(--color_bad);
  }

  .chat_error:empty {
    display: none;
  }

  .chat_errors {
    padding: 12px 16px;
    border-radius: var(--radius_md);
    background: var(--color_bad_bg);
    color: var(--color_bad);
    font-size: var(--text_sm);
  }

  .chat_errors ul {
    margin-top: 4px;
    padding-left: 1.1rem;
  }

  .chat_submit {
    align-self: flex-start;
  }

  .chat_submit[aria-disabled='true'] {
    opacity: 0.7;
    cursor: progress;
  }

  .chat_restart {
    align-self: flex-start;
    min-height: var(--tap_min);
    padding-inline: 4px;
    color: var(--color_text_muted);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ── Enhanced chat ── */
  :global(html.js) .chat_step[data-pending] {
    display: none;
  }

  :global(html.js) .chat_step[data-answered] .chat_options {
    display: none;
  }

  :global(html.js) .chat_step:not([data-pending]) > .chat_bubble,
  .chat_done:not([hidden]) {
    animation: chat_in 260ms var(--ease_out) both;
  }

  @keyframes chat_in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .chat_step:not([data-pending]) > .chat_bubble,
    .chat_done:not([hidden]) {
      animation: none;
    }

    .quote_bar::after {
      transition: none;
    }
  }
</style>
