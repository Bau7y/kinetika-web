---
import type { GetStaticPaths } from 'astro';
import GuideView from '../../../views/GuideView.astro';
import { getGuides, type Guide } from '../../../data/guides';

export const getStaticPaths = (async () =>
  (await getGuides('en')).map((guide) => ({ params: { slug: guide.data.url_slug }, props: { guide } }))) satisfies GetStaticPaths;

const { guide } = Astro.props as { guide: Guide };
---
<GuideView lang="en" guide={guide} />
