---
/**
 * About: where the company comes from and where it serves. The district list replaces a
 * team photo: real, indexable local text (it also feeds schema.org areaServed).
 */
import { districts } from '../../data/service_area';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  number: string;
}
const { lang, number } = Astro.props;
const t = useTranslations(lang);
---
<section id="nosotros" class="section section_band" aria-labelledby="why_title">
  <div class="container why">
    <div class="why_text">
      <p class="section_label"><span>{number}</span>{t('label.about')}</p>
      <h2 id="why_title" class="visually_hidden">{t('why.eyebrow')}</h2>
      <blockquote class="why_quote" data-reveal>
        <p>“{t('why.quote')}”</p>
      </blockquote>
      <p class="why_body" data-reveal>{t('why.text')}</p>
      <p class="why_signature">{t('why.signature')} <span>· {t('why.place')}</span></p>
    </div>

    <aside class="why_area" aria-labelledby="area_title" data-reveal data-spotlight>
      <h3 id="area_title">{t('area.title')}</h3>
      <p class="why_districts">{districts.join(' · ')}</p>
      <p>{t('area.online')}</p>
    </aside>
  </div>
</section>

<style>
  .why {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space_lg);
    align-items: center;
  }

  .why_text {
    flex: 2 1 520px;
    display: flex;
    flex-direction: column;
    gap: var(--space_sm);
  }

  .why_quote {
    font-weight: 500;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .why_body {
    max-width: 620px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color_text_secondary);
  }

  .why_signature {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .why_signature span {
    font-weight: 400;
    color: var(--color_text_muted);
  }

  .why_area {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: var(--radius_xl);
    border: 1px solid var(--color_line);
  }

  .why_area h3 {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .why_districts {
    font-size: var(--text_sm);
    font-weight: 400;
    line-height: 1.7;
    color: var(--color_text_muted);
  }

  .why_area p:not(.why_districts) {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color_text_secondary);
  }
</style>
