---
/**
 * Before/after: the same restaurant order, step by step, by hand and with a
 * web system. Static content that reveals row by row on scroll; nothing for
 * the visitor to operate. Without JS every row is simply visible.
 */
import { compareCopy } from '../../data/demos/compare';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Position in the home page, set by HomeView. */
  number: string;
}
const { lang, number } = Astro.props;
const t = useTranslations(lang);

const demo = compareCopy[lang];
---
<section id="antes-despues" class="section container" aria-labelledby="compare_title">
  <p class="section_label" data-reveal data-i="0"><span>{number}</span>{t('label.compare')}</p>
  <h2 id="compare_title" class="section_title compare_title" data-reveal data-i="1">{t('compare.title')}</h2>
  <p class="lede compare_lede" data-reveal data-i="2">{t('compare.lede')}</p>

  <table class="compare">
    <caption class="visually_hidden">{demo.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{demo.head_task}</th>
        <th scope="col">{t('compare.before')}</th>
        <th scope="col" class="compare_after_head">{t('compare.after')}</th>
      </tr>
    </thead>
    <tbody>
      {demo.rows.map((row, i) => (
        <tr data-reveal data-i={i}>
          <th scope="row">{row.task}</th>
          <td class="compare_before" data-label={t('compare.before')}>{row.before}</td>
          <td class="compare_after" data-label={t('compare.after')}>{row.after}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .compare_title {
    max-width: 820px;
  }

  .compare_lede {
    margin: var(--space_sm) 0 var(--space_lg);
  }

  .compare {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--color_line);
    border-radius: var(--radius_2xl);
    overflow: hidden;
    text-align: left;
  }

  .compare thead th {
    padding: 16px clamp(16px, 3vw, 28px);
    font-family: var(--font_mono);
    font-size: var(--text_xs);
    font-weight: 500;
    letter-spacing: var(--tracking_label);
    text-transform: uppercase;
    color: var(--color_text_muted);
    background: var(--color_surface);
    border-bottom: 1px solid var(--color_line);
  }

  .compare thead .compare_after_head {
    color: var(--color_accent_text);
  }

  .compare tbody th,
  .compare tbody td {
    padding: clamp(16px, 2.4vw, 24px) clamp(16px, 3vw, 28px);
    vertical-align: top;
    border-top: 1px solid var(--color_line);
  }

  .compare tbody tr:first-child th,
  .compare tbody tr:first-child td {
    border-top: 0;
  }

  .compare tbody th {
    width: 22%;
    font-weight: 600;
  }

  .compare_before {
    color: var(--color_text_muted);
    /* Dashed rule: the manual way is the unfinished one */
    border-left: 1px dashed var(--color_line_strong);
  }

  .compare_after {
    color: var(--color_text);
    background: var(--color_accent_tint);
    border-left: 2px solid var(--color_accent);
  }

  @media (max-width: 760px) {
    .compare thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .compare,
    .compare tbody,
    .compare tr,
    .compare th,
    .compare td {
      display: block;
    }

    .compare tbody th {
      width: auto;
      padding-bottom: 8px;
      border-top: 1px solid var(--color_line);
    }

    .compare tbody tr:first-child th {
      border-top: 0;
    }

    .compare tbody td {
      border-top: 0;
      padding-top: 10px;
    }

    .compare td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 4px;
      font-family: var(--font_mono);
      font-size: var(--text_xs);
      letter-spacing: var(--tracking_label);
      text-transform: uppercase;
      color: var(--color_text_muted);
    }

    .compare_after::before {
      color: var(--color_accent_text);
    }
  }
</style>
