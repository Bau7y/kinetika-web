---
/** Guides index, shared by /guias and /en/guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import { breadcrumbSchema } from '../lib/structured_data';
import GuideCards from '../components/ui/GuideCards.astro';
import { getGuides } from '../data/guides';
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const guides = await getGuides(lang);
const crumbs = [
  { name: t('nav.home'), href: routes.home[lang] },
  { name: t('nav.guides'), href: routes.guides[lang] },
];
---
<BaseLayout lang={lang} title={t('guides.seo_title')} description={t('guides.meta')} alternates={routes.guides}>
  <JsonLd slot="head" data={breadcrumbSchema(Astro.site!, crumbs)} />
  <section class="guides_index" aria-labelledby="guides_title">
    <div class="container">
      <Breadcrumbs lang={lang} items={crumbs} />
      <h1 id="guides_title" class="guides_title">{t('guides.title')}</h1>
      <p class="lede">{t('guides.lede')}</p>
      <div class="guides_list">
        <GuideCards guides={guides} as="h2" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .guides_index {
    padding: calc(var(--navbar_h) + var(--space_sm)) 0 var(--section_py);
  }

  .guides_title {
    margin: var(--space_lg) 0 var(--space_sm);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 700;
    line-height: var(--leading_tight);
    letter-spacing: -0.035em;
  }

  .guides_list {
    margin-top: var(--space_xl);
  }
</style>
