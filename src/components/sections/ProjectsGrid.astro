---
/**
 * Portfolio of projects on the home page, as case-study cards (captures in
 * src/assets/work/<key>.png, regenerated with `yarn capture:work`).
 */
import ProjectCard from '../ui/ProjectCard.astro';
import SectionHead from '../ui/SectionHead.astro';
import { getProjects } from '../../data/work';
import { routes, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  number: string;
}
const { lang, number } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---
<section id="proyectos" class="section container" aria-labelledby="projects_title">
  <SectionHead id="projects_title" number={number} label={t('label.projects')} title={t('projects.title')} lede={t('projects.lede')} />

  <ul role="list" class="projects_grid">
    {projects.map((p, i) => (
      <li data-reveal data-i={i}>
        <ProjectCard lang={lang} project={p} index={i} />
      </li>
    ))}
  </ul>

  <p class="projects_all">
    <a href={routes.projectsBase[lang]}>{t('projects.all')} <span aria-hidden="true">→</span></a>
  </p>
</section>

<style>
  .projects_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--space_md);
  }

  .projects_all {
    margin-top: var(--space_lg);
  }

  .projects_all a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap_min);
    font-weight: 600;
  }
</style>
