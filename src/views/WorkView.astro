---
/**
 * Service or project page, shared by /servicios, /proyectos and their
 * English routes. Projects add the case study (problem → solution → result);
 * services list the projects that show them. Each entry may bring its own
 * demo (slot "demo").
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkHero from '../components/work/WorkHero.astro';
import WorkDemo from '../components/work/WorkDemo.astro';
import Prose from '../components/ui/Prose.astro';
import Button from '../components/ui/Button.astro';
import WaitlistForm from '../components/work/WaitlistForm.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../lib/structured_data';
import Faq from '../components/ui/Faq.astro';
import Chips from '../components/ui/Chips.astro';
import ClosingCta from '../components/ui/ClosingCta.astro';
import { render } from 'astro:content';
import { getProjects, getWork, type Work } from '../data/work';
import { pairHrefs } from '../data/pages';
import { getLegalHref } from '../data/legal';
import { formatDate, routes, useTranslations, type Lang } from '../i18n/ui';
import { homeAnchor } from '../i18n/routes';
import { statusBadge } from '../data/work_status';

interface Props {
  lang: Lang;
  work: Work;
}
const { lang, work } = Astro.props;
const isProject = work.data.kind === 'project';
const t = useTranslations(lang);
const privacyHref = await getLegalHref('privacidad', lang);
const { data } = work;
const { Content } = await render(work);
const hasBody = Boolean(work.body?.trim());

const alternates = pairHrefs({ es: await getWork('es'), en: await getWork('en') })(work.key, lang);
const others = (await getWork(lang)).filter((w) => w.key !== work.key && w.data.kind === data.kind);
// Services point to the projects that put them into practice
const showcase = isProject ? [] : await getProjects(lang);
const crumbs = [
  { name: t('nav.home'), href: routes.home[lang] },
  isProject
    ? { name: t('nav.projects'), href: routes.projectsBase[lang] }
    : { name: t('nav.services'), href: homeAnchor(lang, 'servicios') },
  { name: data.name, href: work.href },
];
---
<BaseLayout lang={lang} title={data.seo_title} description={data.meta_description} alternates={alternates}>
  <JsonLd
    slot="head"
    data={[
      serviceSchema(Astro.site!, lang, {
        name: data.name,
        type: data.service_type,
        description: data.meta_description,
        path: work.href,
        audience: data.audience,
        url: data.external_url,
      }),
      breadcrumbSchema(Astro.site!, crumbs),
      ...(data.faq.length > 0 ? [faqSchema(data.faq)] : []),
    ]}
  />
  <WorkHero lang={lang} work={work} crumbs={crumbs} />

  <!-- Short answer: quotable on its own by search engines and assistants -->
  <section class="container work_answer" aria-labelledby="answer_title">
    <h2 id="answer_title">{data.answer.question}</h2>
    <p>{data.answer.text}</p>
    <dl class="work_facts">
      <div><dt>{t('work.facts_for')}</dt><dd>{data.audience}</dd></div>
      <div><dt>{t('work.facts_status')}</dt><dd>{t(statusBadge[data.status].label)}</dd></div>
      <div><dt>{t('work.facts_where')}</dt><dd>{t('work.facts_where_value')}</dd></div>
      <div><dt>{t('updated.label')}</dt><dd><time datetime={data.updated.toISOString().slice(0, 10)}>{formatDate(data.updated, lang)}</time></dd></div>
    </dl>
  </section>

  {data.case && (
    <section class="section container work_case" aria-labelledby="case_title">
      <p class="section_label"><span>01</span>{t('case.label')}</p>
      <h2 id="case_title" class="section_title work_h2">{t('case.title')}</h2>
      <ol role="list" class="work_case_steps">
        <li data-reveal data-i="0"><h3 class="eyebrow">{t('case.problem')}</h3><p>{data.case.problem}</p></li>
        <li data-reveal data-i="1"><h3 class="eyebrow">{t('case.solution')}</h3><p>{data.case.solution}</p></li>
        <li data-reveal data-i="2" class="work_case_result"><h3 class="eyebrow">{t('case.result')}</h3><p>{data.case.result}</p></li>
      </ol>
      <Chips items={data.case.tags} label={t('case.tags')} class="work_tags" />
    </section>
  )}

  {data.demo && (
    <WorkDemo lang={lang} title={data.demo.title} text={data.demo.text}>
      <slot name="demo" />
    </WorkDemo>
  )}

  <section class="section section_band" aria-labelledby="highlights_title">
    <div class="container">
      <h2 id="highlights_title" class="section_title work_h2">{data.highlights.title}</h2>
      <ul role="list" class="work_highlights">
        {data.highlights.items.map((item, i) => (
          <li data-reveal data-i={i % 2} data-spotlight>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {data.comparison && (
    <section class="section container" aria-labelledby="compare_table_title">
      <h2 id="compare_table_title" class="section_title work_h2">{data.comparison.title}</h2>
      <div class="work_table" role="region" aria-labelledby="compare_table_title" tabindex="0">
        <table role="table">
          <caption class="visually_hidden">{data.comparison.title}</caption>
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader">{t('work.compare_aspect')}</th>
              <th scope="col" role="columnheader">{data.comparison.columns[0]}</th>
              <th scope="col" role="columnheader" class="work_table_us">{data.comparison.columns[1]}</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {data.comparison.rows.map(([aspect, a, b]) => (
              <tr role="row">
                <th scope="row" role="rowheader">{aspect}</th>
                <td role="cell" data-label={data.comparison!.columns[0]}>{a}</td>
                <td role="cell" class="work_table_us" data-label={data.comparison!.columns[1]}>{b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="section container" aria-labelledby="steps_title">
    <h2 id="steps_title" class="section_title work_h2">{data.steps.title}</h2>
    <ol role="list" class="work_steps">
      {data.steps.items.map((step, i) => (
        <li data-reveal>
          <span class="mono work_step_n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    {hasBody && <div class="work_body"><Prose><Content /></Prose></div>}
  </section>

  <slot />

  {showcase.length > 0 && (
    <section class="section container" aria-labelledby="showcase_title">
      <h2 id="showcase_title" class="section_title work_h2">{t('service.showcase')}</h2>
      <ul role="list" class="work_showcase">
        {showcase.map((p, i) => (
          <li data-reveal data-i={i}>
            <a href={p.href}>
              <span class="mono work_showcase_n">{String(i + 1).padStart(2, '0')}</span>
              <strong>{p.data.name}</strong>
              <span>{p.data.case?.solution}</span>
              <span class="work_showcase_more">{t('projects.view_case')} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {data.status === 'waitlist' && (
    <WaitlistForm lang={lang} product={work.key} privacyHref={privacyHref} />
  )}

  {data.faq.length > 0 && (
    <section class:list={['section', data.status !== 'waitlist' && 'section_band']} aria-labelledby="work_faq_title">
      <div class="container">
        <h2 id="work_faq_title" class="section_title work_h2">{t('work.faq_title')}</h2>
        <Faq items={data.faq} />
      </div>
    </section>
  )}

  <ClosingCta
    eyebrow={t('closing.eyebrow')}
    title={data.cta.title}
    text={data.cta.text}
    primary={data.status === 'waitlist'
      ? { href: '#lista-de-espera', label: t('work.cta_waitlist') }
      : { href: routes.quote[lang], label: t('work.cta_quote') }}
    secondary={{ href: routes.projectsBase[lang], label: t('hero.cta_secondary') }}
  >
    {others.length > 0 && (
      <nav class="work_others" aria-labelledby="work_others_title">
        <h3 id="work_others_title" class="eyebrow">{t(isProject ? 'case.others' : 'service.others')}</h3>
        <ul role="list">
          {others.map((p) => <li><a href={p.href}>{p.data.name}</a></li>)}
        </ul>
      </nav>
    )}
  </ClosingCta>
</BaseLayout>

<style>
  .work_case_steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color_line);
    border-radius: var(--radius_xl);
    background: var(--color_line);
  }

  .work_case_steps li {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(20px, 3vw, 32px);
    background: var(--color_surface);
  }

  .work_case_steps p {
    color: var(--color_text_secondary);
  }

  .work_case_steps .work_case_result p {
    color: var(--color_text);
  }

  .work_case :global(.work_tags) {
    margin-top: var(--space_md);
  }


  .work_showcase {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space_sm);
  }

  .work_showcase a {
    display: grid;
    gap: 10px;
    height: 100%;
    padding: 24px;
    border: 1px solid var(--color_line);
    border-radius: var(--radius_xl);
    background: var(--color_surface);
    color: var(--color_text_secondary);
    text-decoration: none;
    transition: border-color var(--duration_fast) ease;
  }

  .work_showcase strong {
    font-size: var(--text_lg);
    font-weight: 600;
    color: var(--color_text);
  }

  .work_showcase_n {
    font-size: var(--text_xs);
    color: var(--color_text_muted);
  }

  .work_showcase_more {
    align-self: end;
    color: var(--color_accent_text);
    font-weight: 500;
  }

  @media (hover: hover) and (pointer: fine) {
    .work_showcase a:hover {
      border-color: var(--color_line_strong);
      color: var(--color_text_secondary);
    }
  }

  .work_answer {
    display: grid;
    gap: var(--space_sm);
    padding-block: var(--space_xl) 0;
  }

  .work_answer h2 {
    font-size: var(--text_h3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .work_answer > p {
    max-width: 68ch;
    padding: 20px 24px;
    border-left: 3px solid var(--color_accent);
    border-radius: 0 var(--radius_lg) var(--radius_lg) 0;
    background: var(--color_accent_tint);
    font-size: var(--text_md);
    line-height: 1.65;
  }

  .work_facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px 24px;
    margin-top: var(--space_xs);
  }

  .work_facts dt {
    font-family: var(--font_mono);
    font-size: var(--text_xs);
    letter-spacing: var(--tracking_label);
    text-transform: uppercase;
    color: var(--color_text_muted);
  }

  .work_facts dd {
    margin-top: 4px;
    font-size: var(--text_sm);
    color: var(--color_text_secondary);
  }

  .work_table {
    overflow-x: auto;
    border-radius: var(--radius_xl);
    border: 1px solid var(--color_line);
  }

  .work_table table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .work_table th,
  .work_table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--color_line);
    text-align: left;
    vertical-align: top;
  }

  .work_table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .work_table thead th {
    font-family: var(--font_mono);
    font-size: var(--text_xs);
    font-weight: 500;
    letter-spacing: var(--tracking_label);
    text-transform: uppercase;
    color: var(--color_text_muted);
  }

  .work_table tbody th {
    font-weight: 600;
  }

  .work_table td {
    color: var(--color_text_secondary);
  }

  .work_table .work_table_us {
    background: var(--color_accent_tint);
    color: var(--color_text);
  }

  /* Narrow screens: each row becomes a card with labelled cells, no sideways scroll.
     Explicit roles keep the table semantics that display:block would drop. */
  @media (max-width: 639px) {
    .work_table {
      overflow: visible;
    }

    .work_table table {
      min-width: 0;
    }

    .work_table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .work_table tbody,
    .work_table tr,
    .work_table th,
    .work_table td {
      display: block;
    }

    .work_table tbody tr {
      border-bottom: 1px solid var(--color_line);
    }

    .work_table tbody tr:last-child {
      border-bottom: 0;
    }

    .work_table tbody th,
    .work_table td {
      border-bottom: 0;
      padding: 12px 16px 0;
    }

    .work_table tbody tr > :last-child {
      padding-bottom: 14px;
    }

    .work_table td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      font-family: var(--font_mono);
      font-size: var(--text_xs);
      letter-spacing: var(--tracking_label);
      text-transform: uppercase;
      color: var(--color_text_muted);
    }

    .work_table td.work_table_us {
      margin: 8px 16px 0;
      padding: 10px 12px 12px;
      border-radius: var(--radius_md);
    }

    .work_table tbody tr > td.work_table_us:last-child {
      margin-bottom: 14px;
      padding-bottom: 12px;
    }
  }

  .work_h2 {
    max-width: 800px;
    margin-bottom: var(--space_lg);
  }

  .work_highlights {
    display: grid;
    gap: var(--space_sm);
  }

  .work_highlights li {
    padding: 28px;
    border-radius: var(--radius_xl);
    background: var(--color_raised);
    border: 1px solid var(--color_line);
  }

  .work_highlights h3,
  .work_steps h3 {
    font-size: var(--text_xl);
    font-weight: 700;
  }

  .work_highlights p,
  .work_steps p {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--color_text_secondary);
  }

  .work_steps {
    display: grid;
    gap: var(--space_md);
  }

  .work_steps li {
    padding-top: var(--space_sm);
    border-top: 1px solid var(--color_line_strong);
  }

  .work_step_n {
    display: block;
    margin-bottom: 8px;
    font-size: var(--text_xs);
    color: var(--color_accent_text);
  }

  .work_body {
    margin-top: var(--space_xl);
  }


  .work_others {
    margin-top: var(--space_lg);
  }

  .work_others ul {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: var(--space_xs);
  }

  .work_others a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap_min);
    font-weight: 500;
  }

  @media (min-width: 760px) {
    .work_highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work_steps {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }
</style>
