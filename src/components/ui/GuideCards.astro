---
/** Grid of guide cards (home preview and guides index). */
import type { Guide } from '../../data/guides';

interface Props {
  guides: Guide[];
  /** Heading level of each card title. */
  as?: 'h2' | 'h3';
}
const { guides, as: Title = 'h3' } = Astro.props;
---
<ul role="list" class="guide_cards">
  {guides.map((g, i) => (
    <li data-reveal data-i={i}>
      <a href={g.href} class="guide_card" data-spotlight data-lift>
        <span class="eyebrow">{g.data.topic}</span>
        <Title class="guide_card_title">{g.data.title}</Title>
        <span class="guide_card_text">{g.data.summary}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .guide_cards {
    display: grid;
    gap: var(--space_sm);
  }

  .guide_card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 28px;
    border-radius: 18px;
    background: var(--color_raised);
    border: 1px solid var(--color_line);
    color: var(--color_text);
    text-decoration: none;
    transition:
      transform var(--duration_press) var(--ease_out),
      translate var(--duration_base) var(--ease_out);
  }

  /* Hover ring on a layer that only fades */
  .guide_card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--color_accent_border_strong);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration_fast) ease;
  }

  .guide_card:active {
    scale: 0.97;
  }

  @media (hover: hover) and (pointer: fine) {
    .guide_card:hover {
      color: var(--color_text);
    }

    .guide_card:hover::after {
      opacity: 1;
    }
  }

  .guide_card_title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: var(--leading_snug);
  }

  .guide_card_text {
    font-size: 0.9375rem;
    color: var(--color_text_secondary);
  }

  @media (min-width: 760px) {
    .guide_cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
