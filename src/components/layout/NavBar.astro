---
/**
 * Floating pill navigation.
 * - A glass capsule, centered, that turns more solid after scrolling.
 * - On wide screens a highlight slides to the current section (scroll spy)
 *   or to the hovered link. It is a duplicated, clipped copy of the links:
 *   only clip-path animates, so the background and the text color change
 *   together, with no layout work.
 * - On narrow screens the pill opens a panel right under it (NavPanel).
 * Behavior lives in src/scripts/navbar.ts.
 */
import Logo from '../brand/Logo.astro';
import LangSwitch from './LangSwitch.astro';
import NavPanel from './NavPanel.astro';
import { routes, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  altHref: string;
}
const { lang, altHref } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: routes.solutions[lang], label: t('nav.solutions'), section: undefined },
  { href: routes.projectsBase[lang], label: t('nav.experience'), section: undefined },
  { href: routes.about[lang], label: t('nav.about'), section: undefined },
  { href: routes.guides[lang], label: t('nav.guides'), section: undefined },
];
const quoteHref = routes.quote[lang];
const path = Astro.url.pathname;
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);
---
<div class="scroll_sentinel" data-scroll-sentinel aria-hidden="true"></div>
<header class="navbar" data-navbar>
  <!-- Blurred veil behind the open menu: it also takes the taps, so the page below cannot be used -->
  <div class="pill_scrim" data-menu-scrim aria-hidden="true"></div>
  <div class="pill_wrap">
  <!-- The glass is its own element, outside the pill that keeps the transition name:
       an element with a view-transition-name isolates everything inside it, which
       would leave the glass blurring nothing -->
  <div class="pill_glass" aria-hidden="true"></div>
  <div class="pill">
    <a href={routes.home[lang]} class="pill_brand" aria-label={t('nav.home_label')} translate="no">
      <Logo size={24} />
    </a>

    <nav class="pill_nav" aria-label={t('nav.main_label')}>
      <ul role="list" class="pill_links" data-pill-links>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link.href)} data-section={link.section}>{link.label}</a>
          </li>
        ))}
      </ul>
      <!-- Highlight: the same links, styled as active and clipped to one of them -->
      <ul role="list" class="pill_links pill_highlight" aria-hidden="true" data-pill-highlight>
        {links.map((link) => <li><span>{link.label}</span></li>)}
      </ul>
    </nav>

    <div class="pill_actions">
      <LangSwitch lang={lang} altHref={altHref} />
      <a href={quoteHref} class="btn btn_primary btn_sm pill_cta">{t('nav.quote')}</a>
      <button
        type="button"
        class="pill_menu_btn"
        data-menu-toggle
        data-label-open={t('nav.open_menu')}
        data-label-close={t('nav.close_menu')}
        aria-label={t('nav.open_menu')}
        aria-expanded="false"
        aria-controls="menu_movil"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
  </div>

  <NavPanel links={links} quoteLabel={t('nav.quote')} quoteHref={quoteHref} label={t('nav.mobile_label')} />
</header>

<script>
  import { initNavbar } from '../../scripts/navbar';
  initNavbar();
</script>

<style>
  .scroll_sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 24px;
    pointer-events: none;
  }

  .navbar {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: var(--z_navbar);
    padding-inline: 12px;
    pointer-events: none;
  }

  /* ── The pill ── */
  .pill_wrap {
    position: relative;
    max-width: 1180px;
    margin-inline: auto;
  }

  .pill {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 60px;
    padding: 8px 8px 8px 20px;
    border-radius: var(--radius_full);
    pointer-events: auto;
    /* Stays in place during page transitions */
    view-transition-name: navbar;
  }

  /* Glass: the pane itself (blur, sheen, bright top edge) plus a second layer
     (::after) that adds density once the page is scrolled or the menu is open.
     Only opacity changes, so it stays cheap to paint. */
  .pill_glass {
    position: absolute;
    inset: 0;
    border-radius: var(--radius_full);
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.02) 55%, rgb(255 255 255 / 0.05)),
      rgb(13 20 34 / 0.42);
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      inset 0 -1px 0 rgb(0 0 0 / 0.3),
      0 10px 30px rgb(0 0 0 / 0.22);
    backdrop-filter: blur(22px) saturate(1.7);
    /* Named apart from the pill so it also stays put between pages */
    view-transition-name: navbar_glass;
  }

  .pill_glass::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(7 11 20 / 0.5);
    box-shadow: 0 14px 34px rgb(0 0 0 / 0.3);
    opacity: 0;
    transition: opacity var(--duration_base) var(--ease_out);
  }

  .navbar.scrolled .pill_glass::after,
  .navbar.menu_open .pill_glass::after {
    opacity: 1;
  }

  /* Veil behind the open menu (narrow screens) */
  .pill_scrim {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgb(7 11 20 / 0.45);
    backdrop-filter: blur(14px) saturate(1.2);
    opacity: 0;
    pointer-events: none;
    /* Taps and drags stop here: nothing reaches the page */
    touch-action: none;
    transition: opacity var(--duration_exit) var(--ease_out);
  }

  .navbar.menu_open .pill_scrim {
    opacity: 1;
    pointer-events: auto;
    transition-duration: var(--duration_base);
  }

  /* While the menu is open the page behind does not scroll */
  :global(html.menu_lock) {
    overflow: hidden;
    overscroll-behavior: none;
    scrollbar-gutter: stable;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .pill_glass { background: rgb(13 20 34 / 0.92); }
    .pill_scrim { background: rgb(7 11 20 / 0.8); }
  }

  @media (prefers-reduced-transparency: reduce) {
    .pill_glass {
      background: rgb(13 20 34 / 0.96);
      backdrop-filter: none;
    }
    .pill_scrim {
      background: rgb(7 11 20 / 0.85);
      backdrop-filter: none;
    }
  }

  .pill_brand {
    display: flex;
    align-items: center;
    min-height: var(--tap_min);
    color: var(--color_text);
    text-decoration: none;
  }

  .pill_nav {
    position: relative;
    display: none;
  }

  .pill_links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .pill_links a,
  .pill_links span {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap_min);
    padding-inline: 14px;
    border-radius: var(--radius_full);
    font-size: var(--text_sm);
    font-weight: 500;
    white-space: nowrap;
    color: var(--color_nav_link);
    text-decoration: none;
  }

  .pill_links a:focus-visible {
    outline-offset: -2px;
  }

  /* Dock-style magnification: navbar.ts sets --mag (1 to ~1.2) on each link
     and on its copy in the highlight, so both grow together */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .pill_links a,
    .pill_links span {
      transform: scale(var(--mag, 1));
      transition: transform 140ms var(--ease_out);
    }
  }

  /* Copy of the links in their active look, clipped to one item */
  .pill_highlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--color_accent_tint_strong);
    border-radius: var(--radius_full);
    clip-path: inset(0 50% 0 50% round 999px);
    opacity: 0;
    transition:
      clip-path 320ms var(--ease_out),
      opacity var(--duration_fast) ease;
  }

  .pill_highlight span {
    color: var(--color_text);
  }

  .pill_highlight.is_on {
    opacity: 1;
  }

  .pill_highlight.no_motion {
    transition: none;
  }

  .pill_actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pill_actions :global(.lang_switch) {
    border-radius: var(--radius_full);
  }

  .pill_cta {
    display: none;
    border-radius: var(--radius_full);
  }

  /* Two lines that turn into an X */
  .pill_menu_btn {
    position: relative;
    width: var(--tap_min);
    height: var(--tap_min);
    border-radius: var(--radius_full);
    border: 1px solid var(--color_line_strong);
  }

  .pill_menu_btn span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 1.5px;
    margin: -0.75px 0 0 -9px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--duration_base) var(--ease_out);
  }

  .pill_menu_btn span:nth-child(1) { transform: translateY(-3.5px); }
  .pill_menu_btn span:nth-child(2) { transform: translateY(3.5px); }
  .pill_menu_btn.open span:nth-child(1) { transform: rotate(45deg); }
  .pill_menu_btn.open span:nth-child(2) { transform: rotate(-45deg); }

  @media (min-width: 560px) {
    .pill_cta {
      display: inline-flex;
    }
  }

  @media (min-width: 1080px) {
    .pill_nav {
      display: block;
    }

    .pill_menu_btn {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pill_highlight {
      transition-property: opacity;
    }
  }
</style>
