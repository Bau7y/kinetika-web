---
/**
 * Product page, shared by /productos/<slug> and /en/products/<slug>.
 * Each product brings its own demo (slot "demo").
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductHero from '../components/product/ProductHero.astro';
import ProductDemo from '../components/product/ProductDemo.astro';
import Prose from '../components/ui/Prose.astro';
import Button from '../components/ui/Button.astro';
import WaitlistForm from '../components/product/WaitlistForm.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../lib/structured_data';
import { render } from 'astro:content';
import { getProducts, type Product } from '../data/products';
import { pairHrefs } from '../data/pages';
import { getLegalHref } from '../data/legal';
import { formatDate, routes, useTranslations, type Lang } from '../i18n/ui';
import { statusBadge } from '../data/product_status';

interface Props {
  lang: Lang;
  product: Product;
}
const { lang, product } = Astro.props;
const t = useTranslations(lang);
const privacyHref = await getLegalHref('privacidad', lang);
const { data } = product;
const { Content } = await render(product);
const hasBody = Boolean(product.body?.trim());

const alternates = pairHrefs({ es: await getProducts('es'), en: await getProducts('en') })(product.key, lang);
const others = (await getProducts(lang)).filter((p) => p.key !== product.key);
const crumbs = [
  { name: t('nav.home'), href: routes.home[lang] },
  { name: t('nav.products'), href: `${routes.home[lang] === '/' ? '' : routes.home[lang]}/#interruptor` },
  { name: data.name, href: product.href },
];
---
<BaseLayout lang={lang} title={data.seo_title} description={data.meta_description} alternates={alternates}>
  <JsonLd
    slot="head"
    data={[
      serviceSchema(Astro.site!, lang, {
        name: data.name,
        type: data.service_type,
        description: data.meta_description,
        path: product.href,
        audience: data.audience,
        url: data.external_url,
      }),
      breadcrumbSchema(Astro.site!, crumbs),
      ...(data.faq.length > 0 ? [faqSchema(data.faq)] : []),
    ]}
  />
  <ProductHero lang={lang} product={product} crumbs={crumbs} />

  <!-- Short answer: quotable on its own by search engines and assistants -->
  <section class="container product_answer" aria-labelledby="answer_title">
    <h2 id="answer_title">{data.answer.question}</h2>
    <p>{data.answer.text}</p>
    <dl class="product_facts">
      <div><dt>{t('product.facts_for')}</dt><dd>{data.audience}</dd></div>
      <div><dt>{t('product.facts_status')}</dt><dd>{t(statusBadge[data.status].label)}</dd></div>
      <div><dt>{t('product.facts_where')}</dt><dd>{t('product.facts_where_value')}</dd></div>
      <div><dt>{t('updated.label')}</dt><dd><time datetime={data.updated.toISOString().slice(0, 10)}>{formatDate(data.updated, lang)}</time></dd></div>
    </dl>
  </section>

  <ProductDemo lang={lang} title={data.demo.title} text={data.demo.text}>
    <slot name="demo" />
  </ProductDemo>

  <section class="section section_band" aria-labelledby="highlights_title">
    <div class="container">
      <h2 id="highlights_title" class="section_title product_h2">{data.highlights.title}</h2>
      <ul role="list" class="product_highlights">
        {data.highlights.items.map((item, i) => (
          <li data-reveal data-i={i % 2} data-spotlight>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {data.comparison && (
    <section class="section container" aria-labelledby="compare_table_title">
      <h2 id="compare_table_title" class="section_title product_h2">{data.comparison.title}</h2>
      <div class="product_table" role="region" aria-labelledby="compare_table_title" tabindex="0">
        <table>
          <caption class="visually_hidden">{data.comparison.title}</caption>
          <thead>
            <tr>
              <th scope="col">{t('product.compare_aspect')}</th>
              <th scope="col">{data.comparison.columns[0]}</th>
              <th scope="col" class="product_table_us">{data.comparison.columns[1]}</th>
            </tr>
          </thead>
          <tbody>
            {data.comparison.rows.map(([aspect, a, b]) => (
              <tr>
                <th scope="row">{aspect}</th>
                <td>{a}</td>
                <td class="product_table_us">{b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="section container" aria-labelledby="steps_title">
    <h2 id="steps_title" class="section_title product_h2">{data.steps.title}</h2>
    <ol role="list" class="product_steps">
      {data.steps.items.map((step, i) => (
        <li data-reveal>
          <span class="mono product_step_n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    {hasBody && <div class="product_body"><Prose><Content /></Prose></div>}
  </section>

  <slot />

  {data.status === 'waitlist' && (
    <WaitlistForm lang={lang} product={product.key} privacyHref={privacyHref} />
  )}

  {data.faq.length > 0 && (
    <section class:list={['section', data.status !== 'waitlist' && 'section_band']} aria-labelledby="product_faq_title">
      <div class="container">
        <h2 id="product_faq_title" class="section_title product_h2">{t('product.faq_title')}</h2>
        <dl class="product_faq">
          {data.faq.map((item) => (
            <div>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <section class="section container product_cta" aria-labelledby="product_cta_title">
    <h2 id="product_cta_title" class="section_title">{data.cta.title}</h2>
    <p class="lede">{data.cta.text}</p>
    {data.status === 'waitlist' ? (
      <Button href="#lista-de-espera" arrow>{t('product.cta_waitlist')}</Button>
    ) : (
      <Button href={routes.quote[lang]} arrow>{t('product.cta_quote')}</Button>
    )}
    {others.length > 0 && (
      <nav class="product_others" aria-labelledby="product_others_title">
        <h3 id="product_others_title" class="eyebrow">{t('product.others')}</h3>
        <ul role="list">
          {others.map((p) => <li><a href={p.href}>{p.data.name}</a></li>)}
        </ul>
      </nav>
    )}
  </section>
</BaseLayout>

<style>
  .product_answer {
    display: grid;
    gap: var(--space_sm);
    padding-block: var(--space_xl) 0;
  }

  .product_answer h2 {
    font-size: var(--text_h3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .product_answer > p {
    max-width: 68ch;
    padding: 20px 24px;
    border-left: 3px solid var(--color_accent);
    border-radius: 0 var(--radius_lg) var(--radius_lg) 0;
    background: var(--color_accent_tint);
    font-size: var(--text_md);
    line-height: 1.65;
  }

  .product_facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px 24px;
    margin-top: var(--space_xs);
  }

  .product_facts dt {
    font-family: var(--font_mono);
    font-size: var(--text_xs);
    letter-spacing: var(--tracking_label);
    text-transform: uppercase;
    color: var(--color_text_muted);
  }

  .product_facts dd {
    margin-top: 4px;
    font-size: var(--text_sm);
    color: var(--color_text_secondary);
  }

  .product_table {
    overflow-x: auto;
    border-radius: var(--radius_xl);
    border: 1px solid var(--color_line);
  }

  .product_table table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .product_table th,
  .product_table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--color_line);
    text-align: left;
    vertical-align: top;
  }

  .product_table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .product_table thead th {
    font-family: var(--font_mono);
    font-size: var(--text_xs);
    font-weight: 500;
    letter-spacing: var(--tracking_label);
    text-transform: uppercase;
    color: var(--color_text_muted);
  }

  .product_table tbody th {
    font-weight: 600;
  }

  .product_table td {
    color: var(--color_text_secondary);
  }

  .product_table .product_table_us {
    background: var(--color_accent_tint);
    color: var(--color_text);
  }

  .product_h2 {
    max-width: 800px;
    margin-bottom: var(--space_lg);
  }

  .product_highlights {
    display: grid;
    gap: var(--space_sm);
  }

  .product_highlights li {
    padding: 28px;
    border-radius: var(--radius_xl);
    background: var(--color_raised);
    border: 1px solid var(--color_line);
  }

  .product_highlights h3,
  .product_steps h3 {
    font-size: var(--text_xl);
    font-weight: 700;
  }

  .product_highlights p,
  .product_steps p {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--color_text_secondary);
  }

  .product_steps {
    display: grid;
    gap: var(--space_md);
  }

  .product_steps li {
    padding-top: var(--space_sm);
    border-top: 1px solid var(--color_line_strong);
  }

  .product_step_n {
    display: block;
    margin-bottom: 8px;
    font-size: var(--text_xs);
    color: var(--color_accent_text);
  }

  .product_body {
    margin-top: var(--space_xl);
  }

  .product_faq {
    display: grid;
    column-gap: var(--space_xl);
  }

  .product_faq > div {
    padding-block: var(--space_md);
    border-top: 1px solid var(--color_line);
  }

  .product_faq dt {
    font-size: var(--text_lg);
    font-weight: 600;
  }

  .product_faq dd {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--color_text_secondary);
  }

  .product_cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space_md);
  }

  .product_others {
    margin-top: var(--space_lg);
  }

  .product_others ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: var(--space_xs);
  }

  .product_others a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap_min);
    font-weight: 500;
  }

  @media (min-width: 760px) {
    .product_highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product_steps {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .product_faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
