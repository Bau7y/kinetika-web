---
/**
 * "This site is the proof": each non-functional requirement highlights the
 * block of the page it lives in. Highlights fade with opacity only.
 */
import { useTranslations, type Lang, type UiKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Position in the home page, set by HomeView. */
  number: string;
}
const { lang, number } = Astro.props;
const t = useTranslations(lang);

const specs = (['hero', 'demos', 'faq', 'form'] as const).map((id) => ({
  id,
  title: t(`proof.${id}_title` as UiKey),
  desc: t(`proof.${id}_desc` as UiKey),
  note: t(`proof.${id}_note` as UiKey),
}));
---
<section id="plano" class="section container" aria-labelledby="proof_title" data-blueprint>
  <p class="section_label" data-reveal data-i="0"><span>{number}</span>{t('label.proof')}</p>
  <h2 id="proof_title" class="section_title" data-reveal data-i="1">{t('proof.title')}</h2>
  <p class="lede proof_lede" data-reveal data-i="2">{t('proof.lede')}</p>

  <div class="proof_grid">
    <ul role="list" class="proof_specs">
      {specs.map((spec, i) => (
        <li>
          <button type="button" class="proof_spec" aria-pressed={i === 0 ? "true" : "false"} aria-controls="proof_plan" data-spec={spec.id} data-note={spec.note}>
            <strong>{spec.title}</strong>
            <span>{spec.desc}</span>
          </button>
        </li>
      ))}
    </ul>

    <div id="proof_plan" class="proof_plan" role="group" aria-label={t('proof.blueprint_label')} data-reveal>
      <div class="proof_browser mono" aria-hidden="true">
        <span></span><span></span><span></span>
        <span class="proof_url">kinetikacr.com</span>
      </div>
      <div class="proof_block proof_block_hero" data-block="hero" data-active>
        {t('proof.block_hero')}
      </div>
      <div class="proof_demos">
        {[0, 1, 2].map(() => <div class="proof_block proof_block_demo" data-block="demos">{t('proof.block_demo')}</div>)}
      </div>
      <div class="proof_block proof_block_faq" data-block="faq">{t('proof.block_faq')}</div>
      <div class="proof_block proof_block_form" data-block="form">{t('proof.block_form')}</div>
      <p class="proof_note" aria-live="polite" data-proof-note>{specs[0].note}</p>
    </div>
  </div>
</section>

<script>
  import { initBlueprint } from '../../scripts/blueprint';
  document.querySelectorAll<HTMLElement>('[data-blueprint]').forEach(initBlueprint);
</script>

<style>
  .proof_lede {
    margin: var(--space_sm) 0 48px;
  }

  .proof_grid {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: stretch;
  }

  .proof_specs {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .proof_spec {
    width: 100%;
    min-height: 64px;
    padding: 14px 18px;
    border-radius: var(--radius_lg);
    border: 1px solid var(--color_line);
    text-align: left;
    font-size: var(--text_sm);
    line-height: 1.5;
    transition: transform var(--duration_press) var(--ease_out);
  }

  .proof_spec:active {
    transform: scale(0.97);
  }

  .proof_spec[aria-pressed='true'] {
    background-color: rgb(61 139 255 / 0.1);
    border-color: var(--color_accent_border_strong);
  }

  .proof_spec strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .proof_spec span {
    color: var(--color_text_muted);
  }

  .proof_plan {
    flex: 2 1 520px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border-radius: var(--radius_xl);
    border: 1px dashed var(--color_accent_border_strong);
    background: var(--color_surface);
  }

  .proof_browser {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text_xs);
    color: var(--color_text_muted);
  }

  .proof_browser span:not(.proof_url) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color_line_strong);
  }

  .proof_url {
    margin-left: 10px;
  }

  .proof_block {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--color_accent_tint);
    border: 1px solid var(--color_accent_border);
    font-family: var(--font_mono);
    font-size: var(--text_xs);
    color: var(--color_accent_text);
  }

  /* Highlight ring on a pseudo-element: only its opacity changes */
  .proof_block::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 14px;
    border: 2px solid var(--color_accent);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .proof_block[data-active]::after {
    opacity: 1;
  }

  .proof_block_hero {
    height: 140px;
  }

  .proof_demos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .proof_block_demo {
    height: 90px;
  }

  .proof_block_faq {
    height: 70px;
  }

  .proof_block_form {
    height: 100px;
  }

  .proof_note {
    margin-top: 6px;
    font-size: var(--text_sm);
    color: var(--color_text_secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .proof_block::after {
      transition: none;
    }
  }
</style>
