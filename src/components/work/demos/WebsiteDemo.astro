---
/**
 * Website demo: a sample business site with a contact form and, next to it,
 * the owner's inbox. Sending the form adds the message to the inbox.
 * Nothing leaves the browser.
 */
import type { Lang } from '../../../i18n/routes';
import { websiteCopy } from '../../../data/demos/website';

interface Props {
  lang: Lang;
}
const copy = websiteCopy[Astro.props.lang];
---
<div class="web_demo" data-web-demo data-now={copy.now} data-empty={copy.empty_name}>
  <div class="web_site">
    <div class="web_bar mono" aria-hidden="true"><span></span><span></span><span></span> elroble.cr</div>
    <div class="web_site_body">
      <p class="web_site_name">{copy.site}</p>
      <p class="web_site_text">{copy.site_text}</p>
      <form class="web_form" data-web-form>
        <label>
          <span>{copy.name}</span>
          <input name="name" value={copy.name_value} maxlength="60" autocomplete="off" />
        </label>
        <label>
          <span>{copy.message}</span>
          <textarea name="message" rows="3" maxlength="200">{copy.message_value}</textarea>
        </label>
        <button type="submit" class="btn btn_primary btn_sm">{copy.send}</button>
      </form>
    </div>
  </div>

  <div class="web_inbox">
    <p class="eyebrow">{copy.inbox}</p>
    <ul role="list" aria-live="polite" data-web-inbox>
      <li>
        <span class="web_from">{copy.first.from}<span class="mono">{copy.first.when}</span></span>
        <span class="web_text">{copy.first.text}</span>
      </li>
    </ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-web-demo]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-web-form]')!;
    const inbox = root.querySelector<HTMLElement>('[data-web-inbox]')!;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim() || root.dataset.empty || '';
      const message = String(data.get('message') ?? '').trim();
      if (!message) return;

      const item = document.createElement('li');
      item.className = 'web_new';
      const from = document.createElement('span');
      from.className = 'web_from';
      from.textContent = name;
      const when = document.createElement('span');
      when.className = 'mono';
      when.textContent = root.dataset.now ?? '';
      from.append(when);
      const text = document.createElement('span');
      text.className = 'web_text';
      text.textContent = message;
      item.append(from, text);
      inbox.prepend(item);
      while (inbox.children.length > 4) inbox.lastElementChild?.remove();
    });
  });
</script>

<style>
  .web_demo {
    display: grid;
    gap: var(--space_md);
  }

  .web_site,
  .web_inbox {
    border-radius: var(--radius_xl);
    border: 1px solid var(--color_line);
    background: var(--color_raised);
    overflow: hidden;
  }

  .web_bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color_line);
    font-size: var(--text_xs);
    color: var(--color_text_muted);
  }

  .web_bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color_line_strong);
  }

  .web_site_body {
    display: grid;
    gap: 10px;
    padding: 24px;
  }

  .web_site_name {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .web_site_text {
    color: var(--color_text_secondary);
    font-size: 0.9375rem;
  }

  .web_form {
    display: grid;
    gap: 12px;
    margin-top: 8px;
  }

  .web_form label {
    display: grid;
    gap: 6px;
    font-size: var(--text_sm);
    font-weight: 500;
  }

  .web_form input,
  .web_form textarea {
    width: 100%;
    min-height: var(--tap_min);
    padding: 10px 14px;
    border-radius: var(--radius_md);
    border: 1px solid var(--color_line_strong);
    background: var(--color_surface);
    font-size: var(--text_base);
    resize: vertical;
  }

  .web_form button {
    justify-self: start;
  }

  .web_inbox {
    padding: 24px;
  }

  .web_inbox ul {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .web_inbox li {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-radius: var(--radius_lg);
    background: var(--color_surface);
    border: 1px solid var(--color_line);
  }

  .web_inbox :global(.web_from) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-weight: 600;
  }

  .web_inbox :global(.web_from .mono) {
    font-size: var(--text_xs);
    font-weight: 400;
    color: var(--color_accent_text);
  }

  .web_inbox :global(.web_text) {
    font-size: var(--text_sm);
    color: var(--color_text_secondary);
  }

  .web_inbox :global(.web_new) {
    border-color: var(--color_accent_border_strong);
    animation: web_in 260ms var(--ease_out) both;
  }

  @keyframes web_in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .web_inbox :global(.web_new) {
      animation: none;
    }
  }

  @media (min-width: 860px) {
    .web_demo {
      grid-template-columns: 1.3fr 1fr;
      align-items: start;
    }
  }
</style>
