---
/**
 * The path of a contact form, step by step. With JS the steps light up one
 * after another on their own (only while on screen, pausable); without JS or
 * with reduced motion every step is shown complete.
 */
import { flowSteps } from '../../data/flow_steps';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Position in the home page, set by HomeView. */
  number: string;
}
const { lang, number } = Astro.props;
const t = useTranslations(lang);
const steps = flowSteps[lang];
---
<section id="flujo" class="section container flow" aria-labelledby="flow_title" data-flow data-count={steps.length}>
  <p class="section_label" data-reveal data-i="0"><span>{number}</span>{t('label.day')}</p>
  <h2 id="flow_title" class="section_title flow_title" data-reveal data-i="1">{t('day.title')}</h2>
  <p class="lede flow_lede" data-reveal data-i="2">{t('day.lede')}</p>

  <ol role="list" class="flow_steps" data-flow-steps data-reveal>
    {steps.map((s, i) => (
      <li class="flow_step" data-flow-step data-state="done">
        <span class="flow_num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        <code class="flow_log">{s.log}</code>
      </li>
    ))}
  </ol>

  <button type="button" class="flow_toggle" data-flow-toggle aria-pressed="false" hidden data-label-pause={t('day.pause')} data-label-play={t('day.play')}>{t('day.pause')}</button>
</section>

<script>
  import { initAutoFlow } from '../../scripts/auto_flow';
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach(initAutoFlow);
</script>

<style>
  .flow_title {
    max-width: 820px;
  }

  .flow_lede {
    margin: var(--space_sm) 0 var(--space_lg);
  }

  .flow_steps {
    position: relative;
    display: grid;
    gap: var(--space_md);
    counter-reset: none;
  }

  .flow_step {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: var(--space_md) 0 0;
    border-top: 2px solid var(--color_accent);
  }

  .flow_num {
    font-size: var(--text_xs);
    letter-spacing: var(--tracking_label);
    color: var(--color_accent_text);
  }

  .flow_step h3 {
    font-size: var(--text_lg);
    font-weight: 600;
  }

  .flow_step p {
    color: var(--color_text_secondary);
    font-size: var(--text_sm);
  }

  .flow_log {
    justify-self: start;
    margin-top: 6px;
    padding: 4px 8px;
    border-radius: var(--radius_sm);
    background: var(--color_accent_tint);
    font-family: var(--font_mono);
    font-size: var(--text_xs);
    color: var(--color_accent_text);
  }

  .flow_toggle {
    margin-top: var(--space_md);
    min-height: var(--tap_min);
    padding-inline: 1rem;
    border: 1px solid var(--color_line_strong);
    border-radius: var(--radius_md);
    background: none;
    color: var(--color_text_secondary);
    font: inherit;
    font-size: var(--text_sm);
    cursor: pointer;
  }

  @media (min-width: 900px) {
    .flow_steps {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space_lg);
    }
  }

  /*
   * Enhanced: every step starts pending (dashed rule, dim) and is lit by the
   * script, one after another. Only opacity and transform change.
   */
  .flow[data-ready] .flow_step {
    border-top: 2px dashed var(--color_line_strong);
  }

  .flow[data-ready] .flow_step::before {
    content: '';
    position: absolute;
    inset: -2px 0 auto 0;
    height: 2px;
    background: var(--color_accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration_move) var(--ease_out);
  }

  .flow[data-ready] .flow_step > * {
    opacity: 0.45;
    transition: opacity var(--duration_base) var(--ease_out);
  }

  .flow[data-ready] .flow_step[data-state='active']::before,
  .flow[data-ready] .flow_step[data-state='done']::before {
    transform: scaleX(1);
  }

  .flow[data-ready] .flow_step[data-state='active'] > *,
  .flow[data-ready] .flow_step[data-state='done'] > * {
    opacity: 1;
  }

  .flow[data-ready] .flow_step[data-state='done'] > :is(p, .flow_log) {
    opacity: 0.8;
  }

  .flow[data-ready] .flow_log {
    transform: translateY(4px);
    transition:
      opacity var(--duration_base) var(--ease_out),
      transform var(--duration_base) var(--ease_out);
  }

  .flow[data-ready] .flow_step[data-state='active'] .flow_log,
  .flow[data-ready] .flow_step[data-state='done'] .flow_log {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow[data-ready] .flow_step::before,
    .flow[data-ready] .flow_log {
      transition: none;
    }
  }
</style>
