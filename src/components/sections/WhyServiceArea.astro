---
/**
 * About: where the company comes from, what backs the work, its projects and
 * where it serves. The district list replaces a
 * team photo: real, indexable local text (it also feeds schema.org areaServed).
 */
import Badge from '../ui/Badge.astro';
import { districts } from '../../data/service_area';
import { getProjects } from '../../data/work';
import { statusBadge } from '../../data/work_status';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  number: string;
}
const { lang, number } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const skills = [
  t('hero.cred_accounting'),
  t('hero.cred_projects'),
  t('hero.cred_software'),
  'Astro',
  'TypeScript',
  'Node.js',
  'React',
  'Vue',
  'SQL',
];
---
<section id="nosotros" class="section section_band" aria-labelledby="why_title">
  <div class="container why">
    <div class="why_text">
      <p class="section_label"><span>{number}</span>{t('label.about')}</p>
      <h2 id="why_title" class="visually_hidden">{t('why.eyebrow')}</h2>
      <blockquote class="why_quote" data-reveal>
        <p>“{t('why.quote')}”</p>
      </blockquote>
      <p class="why_body" data-reveal>{t('why.text')}</p>
      <ul role="list" class="why_skills" aria-label={t('about.skills_label')} data-reveal>
        {skills.map((s) => <li>{s}</li>)}
      </ul>
      <dl class="why_projects" aria-label={t('about.projects_label')} data-reveal>
        {projects.map((p) => (
          <div>
            <dt><a href={p.href}>{p.data.name}</a></dt>
            <dd>{p.data.service_type}</dd>
            <dd><Badge tone={statusBadge[p.data.status].tone}>{t(statusBadge[p.data.status].label)}</Badge></dd>
          </div>
        ))}
      </dl>
      <div class="why_answer" data-reveal>
        <h3>{t('about.question')}</h3>
        <p>{t('about.definition')}</p>
      </div>
      <p class="why_signature">{t('why.signature')} <span>· {t('why.place')}</span></p>
    </div>

    <aside class="why_area" aria-labelledby="area_title" data-reveal data-spotlight>
      <h3 id="area_title">{t('area.title')}</h3>
      <ul role="list">
        {districts.map((d) => <li>{d}</li>)}
      </ul>
      <p>{t('area.online')}</p>
    </aside>
  </div>
</section>

<style>
  .why {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space_xl);
    align-items: center;
  }

  .why_text {
    flex: 2 1 520px;
    display: flex;
    flex-direction: column;
    gap: var(--space_md);
  }

  .why_quote {
    font-weight: 500;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .why_body {
    max-width: 620px;
    font-size: var(--text_md);
    line-height: 1.65;
    color: var(--color_text_secondary);
  }

  /* Self-contained answer: reads on its own when quoted by a search engine or assistant */
  .why_answer {
    max-width: 620px;
    padding: 20px 22px;
    border-left: 3px solid var(--color_accent);
    border-radius: 0 var(--radius_lg) var(--radius_lg) 0;
    background: var(--color_accent_tint);
  }

  .why_answer h3 {
    font-size: var(--text_lg);
    font-weight: 600;
  }

  .why_answer p {
    margin-top: 6px;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color_text_secondary);
  }

  .why_skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 620px;
  }

  .why_skills li {
    padding: 6px 12px;
    border: 1px solid var(--color_line_strong);
    border-radius: var(--radius_full);
    font-size: var(--text_sm);
    color: var(--color_text_secondary);
  }

  .why_projects {
    max-width: 620px;
  }

  .why_projects > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 16px;
    align-items: center;
    padding-block: 14px;
    border-top: 1px solid var(--color_line);
  }

  .why_projects > div:last-child {
    border-bottom: 1px solid var(--color_line);
  }

  .why_projects dt {
    font-weight: 600;
  }

  .why_projects dt a {
    color: var(--color_text);
    text-decoration: none;
  }

  .why_projects dd:nth-of-type(1) {
    grid-column: 1;
    grid-row: 2;
    font-size: var(--text_sm);
    color: var(--color_text_muted);
  }

  .why_projects dd:nth-of-type(2) {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  @media (hover: hover) and (pointer: fine) {
    .why_projects dt a:hover {
      color: var(--color_accent_text);
    }
  }

  .why_signature {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .why_signature span {
    font-weight: 400;
    color: var(--color_text_muted);
  }

  .why_area {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    border-radius: var(--radius_xl);
    background: var(--color_raised);
    border: 1px solid var(--color_line);
  }

  .why_area h3 {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .why_area ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .why_area li {
    padding: 8px 12px;
    border-radius: var(--radius_sm);
    background: var(--color_surface);
    border: 1px solid var(--color_line_strong);
  }

  .why_area p {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color_text_secondary);
  }
</style>
